{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interzettel/diakrisis/schemas/review-report.schema.json",
  "title": "Diakrisis review report envelope — contract revision 2 (experimental)",
  "description": "Source coverage and bounded review outcomes; empty findings never means scientific certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "status",
    "coverage",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "issues-identified",
        "no-issues-detected",
        "insufficient-evidence"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examined",
        "not_examined"
      ],
      "properties": {
        "examined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "not_examined": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "issues-identified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "disposition"
              ],
              "properties": {
                "disposition": {
                  "not": {
                    "const": "abstain"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "no-issues-detected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "coverage": {
            "properties": {
              "examined": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
