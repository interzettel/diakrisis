{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interzettel/diakrisis/schemas/finding.schema.json",
  "title": "Diakrisis evidence-linked finding — contract revision 1 (experimental)",
  "description": "Machine-readable evidence-bound advisory finding. Contract revision is independent of the single Diakrisis suite SemVer; schema validity does not imply factual accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "reviewer",
    "artifact",
    "category",
    "claim",
    "basis",
    "evidence_status",
    "disposition",
    "severity",
    "confidence_reason",
    "requires_owner_decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Wire-format revision, not an individual skill version."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "terminology-review",
        "conceptual-model-review",
        "argument-review",
        "method-review",
        "communication-review",
        "consistency-review"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "span"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "type": "string",
          "minLength": 1,
          "description": "Quoted phrase or exact location in the inspected artifact; no fabricated excerpts."
        }
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "Bounded finding or explicit unresolved question; an abstention must not assert an established defect."
    },
    "basis": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reason",
          "verification",
          "applicability"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Actual filename/URL/identifier; not merely a source imagined to exist."
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "span": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "inspected",
              "not-inspected"
            ],
            "description": "Whether this source itself was actually inspected for the cited assertion."
          },
          "applicability": {
            "enum": [
              "applicable",
              "uncertain",
              "disputed"
            ],
            "description": "Applicability is contextual to the examined artifact and its declared authority."
          }
        }
      }
    },
    "evidence_status": {
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ]
    },
    "disposition": {
      "enum": [
        "confirmed-conflict",
        "needs-clarification",
        "suggestion",
        "abstain"
      ]
    },
    "severity": {
      "enum": [
        "informational",
        "minor",
        "major",
        "blocking-candidate"
      ],
      "description": "Impact estimate, not workflow blocked state or approval."
    },
    "confidence_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Grounded rationale; not a fabricated numeric confidence score."
    },
    "suggestion": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_owner_decision": {
      "type": "boolean"
    },
    "issue_key": {
      "type": "string",
      "minLength": 1,
      "description": "Optional shared underlying issue; coordinator must inspect content before deduplicating."
    },
    "related_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "IDs of genuinely related findings, not an assertion of independent evidence."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "confirmed-conflict"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "evidence_status": {
            "const": "observed"
          },
          "basis": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "verification",
                "applicability",
                "span"
              ],
              "properties": {
                "verification": {
                  "const": "inspected"
                },
                "applicability": {
                  "const": "applicable"
                },
                "span": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "abstain"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "evidence_status": {
            "const": "unknown"
          },
          "severity": {
            "const": "informational"
          },
          "suggestion": {
            "type": "null"
          }
        }
      }
    }
  ]
}
